# Local development only. Copy to .env (git-ignored). Names only - no real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Public URL of this app; used for OAuth and password-reset redirects.
APP_URL=http://localhost:8501
# Optional: set to 1 to show Google sign-in only after Google is enabled in Supabase.
GOOGLE_LOGIN_ENABLED=1

# Optional integration tests (tests/test_rls_integration.py) - two throwaway test users.
# FINLIFE_TEST_EMAIL_A=
# FINLIFE_TEST_PASSWORD_A=
# FINLIFE_TEST_EMAIL_B=
# FINLIFE_TEST_PASSWORD_B=
